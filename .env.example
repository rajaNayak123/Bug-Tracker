# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/bugtracker

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=1d

# AWS S3 Private Storage Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=my-private-bug-tracker-bucket
AWS_ACCESS_KEY_ID=AKIAEXAMPLEACCESSKEY
AWS_SECRET_ACCESS_KEY=exampleSecretKey1234567890abcdefghijklm

# CORS and Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# Frontend Environment Variable
VITE_API_URL=http://localhost:5001
