{
  "name": "bug-tracker-lite",
  "version": "1.0.0",
  "description": "Bug Tracker Lite — Full Stack Issue Tracking with React, Node.js, Express, MongoDB, and AWS S3",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:backend:mem": "npm --prefix backend run dev:mem",
    "dev:frontend": "npm --prefix frontend run dev",
